# ── vermilion / deckbuilder — copy to .env and fill in ──
# App
DECKBUILDER_PORT=8099
ENVIRONMENT=production

# Database (Phase 1+) — Postgres lives in the `databases` stack, host-networked.
# With network_mode: host the container reaches it on localhost:5436.
DATABASE_URL=postgresql+asyncpg://deckbuilder:CHANGE_ME@localhost:5436/deckbuilder

# Auth (Phase 3+)
JWT_SECRET=CHANGE_ME_LONG_RANDOM
ADMIN_USERNAME=zifnabb
ADMIN_PASSWORD=CHANGE_ME

# Outbound HTTP adapter (Phase 2+) — polite User-Agent for third-party APIs (Scryfall etc.)
HTTP_USER_AGENT=vermilion-deckbuilder/0.1 (+https://vermilion.cooldad.top)
